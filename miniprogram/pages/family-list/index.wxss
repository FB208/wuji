.family-list-page {
  padding: 24rpx;
}

.family-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 16rpx;
  gap: 20rpx;
}

.row-info { flex: 1; min-width: 0; }
.row-name { overflow-wrap: anywhere; }
.row-marks { display: flex; align-items: center; gap: 12rpx; margin-top: 12rpx; }
.default-mark { padding: 2rpx 12rpx; border-radius: 8rpx; background: #ffd84d; color: #111111; font-size: 24rpx; font-weight: 700; }
.default-button { flex-shrink: 0; margin: 0; padding: 12rpx 16rpx; line-height: 1.5; border: 4rpx solid #111111; border-radius: 12rpx; background: #ffd84d; color: #111111; box-shadow: 4rpx 4rpx 0 #111111; font-size: 24rpx; font-weight: 700; }
.default-button::after { border: none; }
.default-button[disabled] { opacity: 0.5; background: #ffd84d; color: #111111; }

.family-row.current {
  border-color: #0a0;
}

.row-mark {
  font-size: 24rpx;
  color: #0a0;
}

.empty {
  padding: 48rpx 24rpx;
  text-align: center;
}
