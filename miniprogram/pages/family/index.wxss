.family {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.name-card {
  padding: 40rpx 32rpx;
  background: #ffd84d;
}

.name {
  font-size: 44rpx;
  font-weight: 700;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
}

.member-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.member {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background: #ffffff;
}

.member-avatar {
  width: 88rpx;
  height: 88rpx;
  border: 4rpx solid #111111;
  border-radius: 50%;
  background: #f8f5ea;
}

.member-avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
}

.member-info {
  flex: 1;
}

.member-name {
  font-size: 32rpx;
  font-weight: 700;
}

.remove-btn {
  padding: 12rpx 28rpx;
  background: #ff9db5;
  border: 4rpx solid #111111;
  border-radius: 12rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 26rpx;
  font-weight: 700;
}

.leave {
  margin-top: 16rpx;
  text-align: center;
  padding: 24rpx;
  background: #ffffff;
  font-weight: 700;
  color: #b3261e;
}
