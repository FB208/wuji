.search-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 24rpx 32rpx;
}

.toolbar {
  display: flex;
  justify-content: flex-end;
}

.clear-btn {
  padding: 8rpx 28rpx;
  background: #ffffff;
  border: 4rpx solid #111111;
  border-radius: 12rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 26rpx;
  font-weight: 700;
}

.result-area {
  flex: 1;
  margin-top: 24rpx;
  overflow: hidden;
}

.placeholder {
  padding: 120rpx 40rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 700;
}

.query-line {
  margin-bottom: 20rpx;
}

.prompt-card {
  padding: 28rpx;
  background: #8ec5ff;
  font-size: 30rpx;
  margin-bottom: 24rpx;
}

.prompt-card.error {
  background: #ff9db5;
}

.candidate-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 24rpx;
}

.retry-btn {
  margin: 0 auto;
  width: 320rpx;
  text-align: center;
  padding: 20rpx 0;
  background: #ffd84d;
  border: 4rpx solid #111111;
  border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 #111111;
  font-weight: 700;
}

/* 输入区固定在页面底部（文档 8.3） */
.input-area {
  padding: 24rpx 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.text-input-row {
  display: flex;
  gap: 16rpx;
}

.text-input {
  flex: 1;
  background: #ffffff;
  border: 4rpx solid #111111;
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  font-size: 30rpx;
}

.send-btn {
  padding: 16rpx 36rpx;
  background: #8ec5ff;
  border: 4rpx solid #111111;
  border-radius: 16rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-weight: 700;
}

.keyboard-entry {
  text-align: center;
}
