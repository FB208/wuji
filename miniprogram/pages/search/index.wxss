@import "../../styles/weui-icon.wxss";

.search-page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 60px 32rpx 0;
}
.message-list { flex: 1; min-height: 0; }
.chat-actions {
  position: fixed;
  top: 8px;
  right: 12px;
  width: 44px;
  height: 44px;
  z-index: 20;
}
.chat-actions .clear-chat-btn[size="mini"] {
  margin: 0;
  padding: 0;
  width: 44px;
  min-width: 44px;
  max-width: 44px;
  height: 44px;
  min-height: 0;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  color: #28251d;
  background: #ffe69a;
  border: 1.5px solid #28251d;
  border-radius: 12px;
  box-shadow: 2px 2px 0 #28251d;
  transition: transform 120ms, background 120ms, box-shadow 120ms;
}
.clear-chat-btn::after { border: none; }
.chat-actions .weui-icon-outlined-delete { width: 22px; height: 22px; }
.chat-actions .clear-chat-btn[disabled] {
  color: #aaa594;
  background: #f0ecdf;
  border-color: #d0cabb;
  box-shadow: none;
}
.chat-actions .clear-chat-btn.clear-chat-btn-pressed {
  transform: translate(2px, 2px);
  background: #ffd84d;
  box-shadow: none;
}
.message {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 8rpx 0 0;
  margin-bottom: 28rpx;
}
.message-user { align-items: flex-end; }
.message-text {
  display: block;
  max-width: 90%;
  box-sizing: border-box;
  padding: 20rpx 24rpx;
  border: 3rpx solid #111111;
  border-radius: 16rpx;
  background: #ffffff;
  font-size: 30rpx;
  line-height: 1.65;
  white-space: pre-wrap;
  overflow-wrap: anywhere;
}
.message-user .message-text { background: #ffd84d; }
.markdown-bubble { min-width: 0; white-space: normal; }
.message-cards { width: 100%; display: flex; flex-direction: column; gap: 20rpx; }
.error-text { color: #9f2341; background: #ffe1e8; }
.pending { letter-spacing: 8rpx; font-weight: 700; }
.chat-bottom { height: 16rpx; }
.page-action { display: flex; flex-direction: column; gap: 20rpx; padding: 24rpx 0; }
.retry-btn {
  margin: 0;
  padding: 16rpx 24rpx;
  border: 4rpx solid #111111;
  border-radius: 12rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  background: #ffd84d;
  color: #111111;
  font-size: 28rpx;
}
.retry-btn::after { border: none; }
