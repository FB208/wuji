<view class="search-page">
  <view class="chat-actions" wx:if="{{sessionReady && !noFamily}}">
    <button size="mini" class="clear-chat-btn" hover-class="clear-chat-btn-pressed" bindtap="clearHistory" aria-label="清空对话" disabled="{{clearing || processing || transcribing || syncingHistory || loadingHistory}}">
      <view class="weui-icon-outlined-delete"></view>
    </button>
  </view>
  <view wx:if="{{noFamily}}" class="page-action">
    <button class="retry-btn" bindtap="goHome">回首页</button>
  </view>
  <view wx:elif="{{errorText}}" class="page-action">
    <text class="error-text" selectable>{{errorText}}</text>
    <button class="retry-btn" bindtap="onRetry">重试</button>
  </view>
  <scroll-view
    class="message-list"
    scroll-y
    scroll-into-view="{{scrollTarget}}"
    upper-threshold="60"
    bindscrolltoupper="loadHistory"
    bindscroll="onListScroll"
    lower-threshold="60"
    bindscrolltolower="onListBottom"
  >
    <view wx:for="{{messages}}" wx:for-item="message" wx:key="id" id="message-{{message.id}}" class="message message-{{message.role}}">
      <block wx:for="{{message.blocks}}" wx:for-item="block" wx:key="index">
        <view wx:if="{{block.type === 'text' && message.role === 'assistant'}}" class="message-text markdown-bubble">
          <markdown-text content="{{block.text}}" />
        </view>
        <text wx:elif="{{block.type === 'text'}}" class="message-text" selectable>{{block.text}}</text>
        <view wx:elif="{{block.type === 'item_cards'}}" class="message-cards">
          <item-card wx:for="{{block.items}}" wx:for-item="card" wx:key="id" item="{{card}}" bind:tap="onItemTap" />
        </view>
        <text wx:elif="{{block.type === 'error'}}" class="message-text error-text" selectable>{{block.message}}</text>
      </block>
    </view>
    <view wx:if="{{pendingText}}" class="message message-user">
      <text class="message-text" selectable>{{pendingText}}</text>
    </view>
    <view wx:if="{{draft}}" class="message message-assistant">
      <view wx:for="{{draft.blocks}}" wx:for-item="block" wx:key="index" class="message-text markdown-bubble">
        <markdown-text content="{{block.text}}" />
      </view>
    </view>
    <view wx:if="{{(processing || transcribing) && !draft}}" class="message message-assistant">
      <text class="message-text pending">···</text>
    </view>
    <view id="chat-bottom" class="chat-bottom"></view>
  </scroll-view>

  <voice-text-input
    id="composer"
    value="{{textQuery}}"
    placeholder="输入消息"
    submit-text="发送"
    idle-text="按住说话"
    maxlength="{{2000}}"
    disabled="{{transcribing || clearing}}"
    submit-disabled="{{!sessionReady || noFamily || processing}}"
    bind:input="onTextInput"
    bind:submit="onTextSubmit"
    bind:recordfinish="onRecordFinish"
    bind:recorderror="onRecordError"
    bind:permissiondenied="onPermissionDenied"
  />
  <notice-panel
    visible="{{notice && notice.visible}}"
    title="{{notice.title}}"
    text="{{notice.text}}"
    secondary-text="{{notice.secondaryText}}"
    confirm-text="{{notice.confirmText}}"
    cancel-text="{{notice.cancelText}}"
    editable="{{notice.editable}}"
    placeholder-text="{{notice.placeholderText}}"
    bind:confirm="onNoticeConfirm"
    bind:cancel="onNoticeCancel"
  />
</view>
