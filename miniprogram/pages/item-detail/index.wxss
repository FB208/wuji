.detail {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.photo-wrap {
  overflow: hidden;
}

.photo {
  width: 100%;
  height: 640rpx;
  display: block;
  background: #eeeeee;
}

.photo-failed {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #888888;
}

.info {
  padding: 32rpx;
  background: #ffffff;
}

.name {
  font-size: 40rpx;
  font-weight: 700;
}

.location {
  margin-top: 16rpx;
  font-size: 44rpx;
  font-weight: 700;
}

.record-text {
  margin-top: 24rpx;
}

.time {
  margin-top: 12rpx;
}

.ops {
  display: flex;
  gap: 32rpx;
}

.op-btn {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  border: 4rpx solid #111111;
  border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 #111111;
  font-weight: 700;
}

.op-btn.edit {
  background: #ffd84d;
}

.op-btn.delete {
  background: #ff9db5;
}
