<view class="detail">
  <view wx:if="{{busy}}" class="text-hint">正在加载</view>
  <view wx:if="{{errorText && !busy}}" class="empty-text">{{errorText}}</view>
  <brutal-button wx:if="{{noFamily && !busy}}" text="去创建或加入家庭" color="yellow" bind:tap="goProfile" />
  <block wx:if="{{ready && !busy && item}}">
  <view class="photo-wrap brutal-card" bindtap="previewImage">
    <image
      wx:if="{{!imageFailed}}"
      class="photo"
      src="{{item.image_url}}"
      mode="aspectFill"
      binderror="onImageError"
      data-image-url="{{item.image_url}}"
    />
    <view wx:else class="photo photo-failed">图片加载失败</view>
  </view>

  <view class="info brutal-card">
    <view class="name">{{item.name}}</view>
    <view class="location">{{item.location_text}}</view>
    <view class="record-text text-hint">“{{item.record_text}}”</view>
    <view class="time text-hint">更新于 {{updatedAtText}}</view>
  </view>

  <view class="ops">
    <brutal-button text="修改记录" color="yellow" disabled="{{busy || deleting || deleted || needsRefresh}}" bind:tap="goEdit" />
    <brutal-button text="{{deleting ? '正在删除' : '删除记录'}}" color="pink" disabled="{{busy || deleting || deleted || needsRefresh}}" bind:tap="onDelete" />
  </view>
  </block>
  <brutal-button wx:if="{{needsRefresh && !busy}}" text="刷新最新记录" color="blue" disabled="{{deleting}}" bind:tap="onRetry" />
  <brutal-button wx:elif="{{errorText && !busy && !blocked && !noFamily && !deleted}}" text="重试" color="blue" disabled="{{deleting}}" bind:tap="onRetry" />
  <brutal-button text="返回物品列表" color="white" bind:tap="goItems" />
</view>
