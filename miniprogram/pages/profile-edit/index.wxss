.profile-edit { padding: 32rpx; }
.editor { padding: 40rpx 32rpx; background: #ffffff; }
.avatar-button {
  display: block;
  width: 168rpx;
  height: 168rpx;
  margin: 0 auto 48rpx;
  padding: 0;
  border: 4rpx solid #111111;
  border-radius: 50%;
  background: #ffd84d;
  overflow: hidden;
  box-sizing: border-box;
}
.avatar-button::after, .save-button::after { border: none; }
.avatar { display: block; width: 100%; height: 100%; }
.avatar-fallback { display: flex; align-items: center; justify-content: center; font-size: 64rpx; font-weight: 700; }
.field-label { margin-bottom: 20rpx; font-size: 30rpx; font-weight: 700; }
.nickname-input { box-sizing: border-box; height: 88rpx; padding: 0 20rpx; border: 4rpx solid #111111; border-radius: 12rpx; font-size: 32rpx; }
.save-button { margin-top: 40rpx; padding: 20rpx; line-height: 1.5; background: #ffd84d; color: #111111; border: 4rpx solid #111111; border-radius: 16rpx; box-shadow: 6rpx 6rpx 0 #111111; font-size: 32rpx; font-weight: 700; }
.save-button[disabled] { opacity: 0.5; background: #ffd84d; color: #111111; }
