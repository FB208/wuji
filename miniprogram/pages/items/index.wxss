.items-page {
  padding: 32rpx;
  padding-bottom: 160rpx;
}

.search-box {
  padding: 8rpx 24rpx;
  background: #ffffff;
}

.search-input {
  height: 72rpx;
  font-size: 30rpx;
}

.list {
  margin-top: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.list-end {
  text-align: center;
  padding: 16rpx 0;
}

.empty {
  margin-top: 160rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.empty-text {
  color: #555555;
}

.empty-btn,
.fab {
  padding: 20rpx 48rpx;
  background: #ffd84d;
  border: 4rpx solid #111111;
  border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 #111111;
  font-weight: 700;
}

.fab {
  position: fixed;
  right: 40rpx;
  bottom: 60rpx;
  z-index: 10;
}
