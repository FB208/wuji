<view class="record-page">
  <!-- 录音状态顶栏：按下后手指会遮住按钮文字，状态同步显示在屏幕上方 -->
  <view
    wx:if="{{state === 'RECORDING'}}"
    class="mic-banner {{micWillCancel ? 'cancel' : micReady ? 'ready' : 'starting'}}"
  >{{micWillCancel ? '松开取消' : micReady ? '正在录音 · 上滑可取消' : '正在开启麦克风…'}}</view>

  <!-- 照片区：相机取景或照片预览（文档 4.2） -->
  <view class="photo-area brutal-card">
    <block wx:if="{{state === 'CAMERA'}}">
      <camera
        wx:if="{{!cameraError}}"
        class="camera"
        device-position="back"
        flash="off"
        binderror="onCameraError"
      />
      <view wx:else class="camera-error">
        <view>相机不可用</view>
        <view class="camera-error-actions">
          <view class="mini-btn brutal-pressable" bindtap="openSetting">去设置</view>
          <view class="mini-btn brutal-pressable" bindtap="chooseFromAlbum">从相册选择</view>
        </view>
      </view>
    </block>
    <block wx:else>
      <image class="preview" src="{{photoPath}}" mode="aspectFill" />
      <view
        wx:if="{{state === 'READY'}}"
        class="retake mini-btn brutal-pressable"
        bindtap="retake"
      >重拍</view>
    </block>
  </view>

  <!-- 引导区（文档 9.3） -->
  <view class="guide">{{secondaryText || '说清楚是什么，放在哪里。'}}</view>
  <view class="guide text-hint">照片仅用于保存物品外观；语音仅转写为文字，不会保存。</view>

  <!-- 主操作区 -->
  <view class="main-action">
    <block wx:if="{{state === 'CAMERA'}}">
      <view class="shutter brutal-pressable" bindtap="takePhoto"></view>
      <view class="album-entry" bindtap="chooseFromAlbum">从相册选择</view>
    </block>
    <hold-to-talk
      id="h2t"
      wx:elif="{{state === 'READY' || state === 'RECORDING'}}"
      idle-text="按住说话"
      disabled="{{processing || !sessionReady}}"
      bind:recordstart="onRecordStart"
      bind:recordready="onRecordReady"
      bind:recordmove="onRecordMove"
      bind:recordcancel="onRecordCancel"
      bind:recordfinish="onRecordFinish"
      bind:recorderror="onRecordError"
      bind:permissiondenied="onPermissionDenied"
    />
  </view>

  <!-- 状态遮罩：上传 / 入库 / 完成 / 失败 -->
  <status-panel
    visible="{{state === 'UPLOADING' || state === 'SAVING' || state === 'SUCCESS' || state === 'FAILED'}}"
    text="{{statusText}}"
    steps="{{steps}}"
    secondary-text="{{secondaryText}}"
    error="{{state === 'FAILED'}}"
    retry-text="{{primaryLabel}}"
    secondary-retry-text="{{secondaryLabel}}"
    bind:retry="onRetry"
    bind:secondary="onSecondary"
  />

  <notice-panel
    visible="{{notice && notice.visible}}"
    title="{{notice.title}}"
    text="{{notice.text}}"
    secondary-text="{{notice.secondaryText}}"
    confirm-text="{{notice.confirmText}}"
    cancel-text="{{notice.cancelText}}"
    editable="{{notice.editable}}"
    placeholder-text="{{notice.placeholderText}}"
    bind:confirm="onNoticeConfirm"
    bind:cancel="onNoticeCancel"
  />
</view>
