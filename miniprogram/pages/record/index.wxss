.record-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
}

.mic-banner {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 50;
  padding: 20rpx 32rpx;
  padding-top: calc(20rpx + env(safe-area-inset-top));
  text-align: center;
  font-size: 30rpx;
  font-weight: 700;
  color: #111111;
  border-bottom: 4rpx solid #111111;
}
.mic-banner.starting { background: #ffb84d; }
.mic-banner.ready { background: #77dfa0; }
.mic-banner.cancel { background: #ff9db5; }

.photo-area {
  position: relative;
  width: 100%;
  aspect-ratio: 4 / 3;
  overflow: hidden;
  background: #dddddd;
}
.camera, .preview { width: 100%; height: 100%; }
.camera-error {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
}
.photo-actions, .operation-actions, .result-actions {
  display: flex;
  gap: 24rpx;
  margin-top: 24rpx;
}
.mini-btn {
  flex: 1;
  margin: 0;
  padding: 16rpx 20rpx;
  line-height: 1.5;
  background: #ffd84d;
  color: #111111;
  border: 4rpx solid #111111;
  border-radius: 12rpx;
  box-shadow: 4rpx 4rpx 0 #111111;
  font-size: 28rpx;
  font-weight: 700;
}
.mini-btn::after { border: none; }
.mini-btn[disabled] { opacity: 0.5; }
.secondary-btn { background: #ffffff; }
.guide {
  margin-top: 32rpx;
  text-align: center;
  font-size: 30rpx;
  color: #555555;
}
.main-action { margin-top: 24rpx; }
.main-action hold-to-talk { display: block; width: 100%; }
.section-title { font-size: 32rpx; font-weight: 700; line-height: 1.6; }
.text-hint { margin-top: 16rpx; font-size: 24rpx; line-height: 1.6; color: #666666; }
.centered { text-align: center; }
.footer-hint { margin-top: 32rpx; }
.saved-note, .question-card { padding: 24rpx; margin-bottom: 28rpx; }
.saved-note { background: #fff3c4; }
.candidate {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  background: #ffffff;
  border: 3rpx solid #111111;
  border-radius: 12rpx;
}
.candidate-image { width: 116rpx; height: 116rpx; border-radius: 8rpx; flex-shrink: 0; }
.candidate-info { flex: 1; min-width: 0; overflow-wrap: break-word; }
.candidate-name { font-size: 30rpx; font-weight: 700; }
.candidate-location { margin-top: 8rpx; color: #555555; font-size: 26rpx; }
.candidate-arrow { font-size: 44rpx; }
.text-entry { margin-top: 28rpx; }
.description-input {
  width: 100%;
  min-height: 120rpx;
  box-sizing: border-box;
  padding: 20rpx;
  background: #ffffff;
  border: 3rpx solid #111111;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.submit-text { margin-top: 20rpx; }
.result-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(0, 0, 0, 0.35);
}
.result-panel {
  width: 100%;
  max-height: 85vh;
  overflow-y: auto;
  padding: 32rpx;
  box-sizing: border-box;
  background: #ffffff;
}
.result-title { font-size: 38rpx; font-weight: 700; text-align: center; }
.result-image { display: block; width: 100%; height: 280rpx; margin: 24rpx 0; border-radius: 12rpx; }
.result-description { font-size: 30rpx; line-height: 1.9; overflow-wrap: break-word; }
.result-name, .result-location { font-weight: 700; margin: 0 8rpx; }
