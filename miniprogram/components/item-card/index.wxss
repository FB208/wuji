.card {
  display: flex;
  padding: 20rpx;
  gap: 20rpx;
  align-items: center;
}

.photo-wrap {
  flex-shrink: 0;
}

.photo {
  width: 160rpx;
  height: 160rpx;
  border: 4rpx solid #111111;
  border-radius: 12rpx;
  background: #eeeeee;
}

.photo-failed {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  color: #888888;
  text-align: center;
}

.info {
  flex: 1;
  min-width: 0;
}

.name {
  font-size: 34rpx;
  font-weight: 700;
  word-break: break-all;
}

.location {
  margin-top: 8rpx;
  font-size: 30rpx;
  word-break: break-all;
}

.time {
  margin-top: 8rpx;
}

/* 查找结果卡：照片置顶，位置使用大号粗体（文档 5.2） */
.mode-big {
  flex-direction: column;
  align-items: stretch;
}

.mode-big .photo {
  width: 100%;
  height: 420rpx;
}

.mode-big .location {
  font-size: 44rpx;
  font-weight: 700;
}
