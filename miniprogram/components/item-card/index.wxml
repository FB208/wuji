<view class="card brutal-card brutal-pressable mode-{{mode}}" bindtap="onTap">
  <view class="photo-wrap">
    <image
      wx:if="{{!imageFailed}}"
      class="photo"
      src="{{item.image_url}}"
      mode="aspectFill"
      binderror="onImageError"
    />
    <view wx:else class="photo photo-failed">图片加载失败</view>
  </view>
  <view class="info">
    <view class="name">{{item.name}}</view>
    <view class="location">{{item.location_text}}</view>
    <view wx:if="{{item.updated_at_text}}" class="time text-hint">{{item.updated_at_text}}</view>
  </view>
</view>
