<view wx:if="{{visible}}" class="mask" catchtap="noop">
  <view class="panel brutal-card">
    <block wx:if="{{steps.length}}">
      <view wx:for="{{steps}}" wx:key="key" class="step step-{{item.status}}">
        <view class="step-icon">
          <text wx:if="{{item.status === 'done'}}" class="icon-done">✓</text>
          <text wx:elif="{{item.status === 'failed'}}" class="icon-failed">✕</text>
          <view wx:elif="{{item.status === 'active'}}" class="spinner"></view>
          <text wx:else class="icon-pending">·</text>
        </view>
        <view class="step-label">{{item.label}}</view>
        <view class="step-detail">{{item.detail}}</view>
      </view>
    </block>
    <block wx:else>
      <view class="text">{{text}}</view>
      <view wx:if="{{secondaryText}}" class="text sub">{{secondaryText}}</view>
    </block>
    <view wx:if="{{secondaryText && steps.length}}" class="text sub">{{secondaryText}}</view>
    <view wx:if="{{error && retryText}}" class="retry brutal-pressable" bindtap="onRetry">{{retryText}}</view>
    <view wx:if="{{error && secondaryRetryText}}" class="retry brutal-pressable" bindtap="onSecondary">{{secondaryRetryText}}</view>
  </view>
</view>
