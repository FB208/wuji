.mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 17, 17, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.panel {
  min-width: 400rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}

.text {
  font-size: 34rpx;
  font-weight: 700;
}

.retry {
  margin-top: 32rpx;
  padding: 20rpx 0;
  background: #ffd84d;
  border: 4rpx solid #111111;
  border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 #111111;
  font-weight: 700;
}
