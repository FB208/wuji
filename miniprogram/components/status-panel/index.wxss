/* 组件内自带 brutal 样式副本，不依赖全局类（隔离模式下全局样式不生效） */
.brutal-card {
  background: #ffffff;
  border: 4rpx solid #111111;
  border-radius: 20rpx;
  box-shadow: 8rpx 8rpx 0 #111111;
}

.brutal-pressable {
  transition: transform 0.08s ease, box-shadow 0.08s ease;
}

.brutal-pressable:active {
  transform: translate(6rpx, 6rpx);
  box-shadow: 2rpx 2rpx 0 #111111;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(17, 17, 17, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}

.panel {
  min-width: 400rpx;
  padding: 48rpx 40rpx;
  text-align: center;
}

.text {
  font-size: 34rpx;
  font-weight: 700;
}

.text.sub {
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #555555;
}

.retry {
  margin-top: 32rpx;
  padding: 20rpx 0;
  background: #ffd84d;
  border: 4rpx solid #111111;
  border-radius: 16rpx;
  box-shadow: 6rpx 6rpx 0 #111111;
  font-weight: 700;
}
