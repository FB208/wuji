# 运行环境：development / production
APP_ENV=production
# 应用内部密钥，用于签名邀请令牌等业务敏感操作
APP_SECRET=

# MySQL 连接串，驱动使用 asyncmy，库名 wuji
DATABASE_URL=mysql+asyncmy://user:password@mysql:3306/wuji?charset=utf8mb4

# 登录访问令牌签名密钥，生产环境必须替换为足够长的随机串
JWT_SECRET=
# 访问令牌有效期（分钟），默认 120
JWT_ACCESS_TTL_MINUTES=120

# 微信小程序 AppID
WECHAT_APP_ID=wxd5ef56552afdea8b
# 微信小程序 AppSecret，仅保存在后端
WECHAT_APP_SECRET=

# RustFS（S3 兼容）服务地址
RUSTFS_ENDPOINT=https://storage.example.com
# RustFS Access Key
RUSTFS_ACCESS_KEY=
# RustFS Secret Key
RUSTFS_SECRET_KEY=
# 存放物品照片的 Bucket 名称
RUSTFS_BUCKET=wuji-items
# 对外可访问的图片域名，写入数据库的 image_url 会基于此地址生成
RUSTFS_PUBLIC_BASE_URL=https://img.example.com

# 火山引擎「大模型录音文件识别 2.0 标准版」服务地址
VOLC_SPEECH_BASE_URL=https://openspeech.bytedance.com
# 火山方舟控制台「API Key 管理」创建的 Key
VOLC_SPEECH_API_KEY=
# 资源 ID，录音文件识别 2.0 标准版固定为 volc.seedasr.auc
VOLC_SPEECH_RESOURCE_ID=volc.seedasr.auc

# OpenAI 兼容语义服务地址，需包含 /v1
SEMANTIC_BASE_URL=https://provider.example.com/v1
# 语义服务 API Key
SEMANTIC_API_KEY=
# 语义服务模型名称
SEMANTIC_MODEL=
# 语义服务请求超时（秒）
SEMANTIC_TIMEOUT_SECONDS=30

# 单张图片大小上限（MB）
MAX_IMAGE_MB=10
# 单次录音时长上限（秒）
MAX_AUDIO_SECONDS=60
# 单个家庭组有效物品记录上限
MAX_FAMILY_ITEMS=500
