# 复制为同目录 .env.secrets，填写后运行 ./sync-secrets.ps1。
# 本文件配置 GitHub Actions 仓库 Secrets，与服务器运行参数 .env 分开。
# 实际 .env.secrets 不得提交。使用 UTF-8；含 $、#、空格等字符的值用单引号包裹。

# Docker 仓库地址及可选命名空间，不含协议和末尾斜杠。
# 最终镜像示例：registry.example.com/team/wuji:wuji-v1.0.0。
REGISTRY=registry.example.com/team
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# 可选 Tailscale OAuth 配置：两项同时填写时启用，同时留空时直接通过 SSH 部署。
# 客户端需有 auth_keys 写权限，并允许 tag:github-actions；只填写一项会报错。
TS_OAUTH_CLIENT_ID=
TS_OAUTH_SECRET=

# 单台 Linux 生产服务器；该用户需具有部署目录写权限和 Docker Compose 执行权限。
# 启用 Tailscale 时填内网地址，例如 100.79.130.23；未启用时填 GitHub 运行器可直连的地址。
SSH_HOST=
SSH_PORT=22
SSH_USER=
SSH_PASSWORD=

# 专用于 wuji 的绝对路径；首次部署前在此目录准备 .env。
DEPLOY_DIR=/opt/wuji
