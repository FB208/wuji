{
  "compilerOptions": {
    "strict": true,
    "target": "ES2019",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "types": ["miniprogram-api-typings"],
    "noImplicitAny": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "baseUrl": "miniprogram"
  },
  "include": ["miniprogram/**/*.ts"]
}
